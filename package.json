{
  "name": "slynk-toolkit",
  "version": "1.1.0",
  "description": "Reusable, cross-agent engineering skills driven by one SKILL.md per skill.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Brandon Slinkard",
    "email": "slinkardbrandon@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slinkardbrandon/slynk-toolkit.git"
  },
  "bin": {
    "slynk-toolkit": "bin/slynk-toolkit.mjs"
  },
  "files": [
    "skills",
    "bin",
    "lib",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "install:local": "node bin/slynk-toolkit.mjs --link",
    "install:local:copy": "node bin/slynk-toolkit.mjs --copy",
    "uninstall:local": "node bin/slynk-toolkit.mjs --uninstall",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "prettier": "^3.8.3",
    "vitest": "^3.2.4"
  }
}
